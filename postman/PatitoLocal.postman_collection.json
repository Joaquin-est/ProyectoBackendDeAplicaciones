{
  "info": {
    "_postman_id": "22b84783-f9ab-4f51-a6c5-1749d295673c",
    "name": "PatitoLocal - Flujo Completo (Via Gateway)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Paso 1: Login Superadmin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r\npm.environment.set(\"token_admin\", jsonData.access_token);\r\nconsole.log(\"Token admin guardado:\", jsonData.access_token.substring(0, 20) + \"...\");"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"superadmin\",\n  \"password\": \"admin123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/api/login",
          "host": ["{{gateway_url}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "Paso 2: Crear Cliente",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_admin}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Esteban\",\n  \"apellido\": \"Quito\",\n  \"email\": \"esteban.quito.2027@test.com\",\n  \"dni\": \"99999998\",\n  \"latitud\": -31.420,\n  \"longitud\": -64.188\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/api/clientes",
          "host": ["{{gateway_url}}"],
          "path": ["api", "clientes"]
        }
      }
    },
    {
      "name": "Paso 3: Login Cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set(\"token_cliente\", pm.response.json().access_token);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"99999998\",\n  \"password\": \"99999998\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/api/login",
          "host": ["{{gateway_url}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "Paso 4: Crear Solicitud",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r\npm.environment.set(\"solicitud_id\", jsonData.id);\r\npm.environment.set(\"tecnico_uuid\", jsonData.tecnicoId);\r\nconsole.log(\"Solicitud creada:\", jsonData.id, \"Asignada al técnico:\", jsonData.tecnicoId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_cliente}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"domicilio\": \"Av. Colon 1234\",\n  \"tiposServicio\": [\"REPARACION\"],\n  \"marca\": \"Apple\",\n  \"modelo\": \"MacBook\",\n  \"descripcion\": \"No enciende\",\n  \"especialidadId\": 1,\n  \"prioridad\": \"NORMAL\",\n  \"fechaHoraProgramada\": \"2026-12-01T10:00:00\",\n  \"esFeriado\": false\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/api/solicitudes",
          "host": ["{{gateway_url}}"],
          "path": ["api", "solicitudes"]
        }
      }
    },
    {
      "name": "Paso 5: Login Técnico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.environment.set(\"token_tecnico\", pm.response.json().access_token);"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"88887777\",\n  \"password\": \"88887777\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{gateway_url}}/api/login",
          "host": ["{{gateway_url}}"],
          "path": ["api", "login"]
        }
      }
    },
    {
      "name": "Paso 6: Aceptar Solicitud",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.environment.set(\"total_costo\", pm.response.json().total);\r\nconsole.log(\"Aceptada. Costo total:\", pm.response.json().total);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_tecnico}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/api/solicitudes/{{solicitud_id}}/aceptar/{{tecnico_uuid}}",
          "host": ["{{gateway_url}}"],
          "path": ["api", "solicitudes", "{{solicitud_id}}", "aceptar", "{{tecnico_uuid}}"]
        }
      }
    },
    {
      "name": "Paso 7: Aprobar Presupuesto",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/api/solicitudes/{{solicitud_id}}/aprobar-presupuesto?importe={{total_costo}}",
          "host": ["{{gateway_url}}"],
          "path": ["api", "solicitudes", "{{solicitud_id}}", "aprobar-presupuesto"],
          "query": [ { "key": "importe", "value": "{{total_costo}}" } ]
        }
      }
    },
    {
      "name": "Paso 8: Finalizar Solicitud",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_tecnico}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/api/solicitudes/{{solicitud_id}}/finalizar",
          "host": ["{{gateway_url}}"],
          "path": ["api", "solicitudes", "{{solicitud_id}}", "finalizar"]
        }
      }
    },
    {
      "name": "Paso 9: Consultar Historial",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_cliente}}" }
        ],
        "url": {
          "raw": "{{gateway_url}}/api/solicitudes/{{solicitud_id}}/historial",
          "host": ["{{gateway_url}}"],
          "path": ["api", "solicitudes", "{{solicitud_id}}", "historial"]
        }
      }
    }
  ]
}