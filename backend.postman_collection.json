              "// Pedir los datos usando ventanas emergentes\npm.variables.set(\"nombre\", prompt(\"Ingresá el Nombre:\"));\npm.variables.set(\"apellido\", prompt(\"Ingresá el Apellido:\"));\npm.variables.set(\"email\", prompt(\"Ingresá el Email:\"));\npm.variables.set(\"dni\", prompt(\"Ingresá el DNI:\"));\npm.variables.set(\"latitud\", prompt(\"Ingresá la Latitud (ej: -31.42):\"));\npm.variables.set(\"longitud\", prompt(\"Ingresá la Longitud (ej: -64.188):\"));"
            ]
          }
        }
      ],
