          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{nombre}}\",\n  \"apellido\": \"{{apellido}}\",\n  \"email\": \"{{email}}\",\n  \"dni\": \"{{dni}}\",\n  \"latitud\": {{latitud}},\n  \"longitud\": {{longitud}}\n}",
